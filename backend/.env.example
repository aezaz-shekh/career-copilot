# Copy this file to `.env` to override any default in app/config.py.
# There are NO API keys in this project and there never will be — every value
# below points at software running on your own machine.

# OLLAMA_URL=http://127.0.0.1:11434

# Swap the model here to change hardware tier. Keep it at or below 4B on 8 GB RAM.
# CHAT_MODEL=llama3.2:3b
# EMBED_MODEL=nomic-embed-text

# TEMPERATURE_SCORING=0.2
# TEMPERATURE_CREATIVE=0.7

# HEALTH_TIMEOUT=3.0
# OLLAMA_TIMEOUT=180.0
